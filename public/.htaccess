<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Cutover domain: gudangsoal.com (lama) -> matrohmatmath.com (final).
  # /api/ dikecualikan: folder sama persis (symlink), biarin dilayani
  # langsung supaya request lama/cache lama yang masih manggil API di
  # domain lama tetap jalan normal tanpa kena redirect.
  RewriteCond %{HTTP_HOST} ^(www\.)?gudangsoal\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^(.*)$ https://matrohmatmath.com/$1 [L,R=301]

  # Redirect www -> non-www (301)
  RewriteCond %{HTTP_HOST} ^www\.matrohmatmath\.com$ [NC]
  RewriteRule ^(.*)$ https://matrohmatmath.com/$1 [L,R=301]

  # Sitemap — taruh paling atas sebelum kondisi lain
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Short link Instagram — taruh sebelum catch-all SPA
  RewriteRule ^ig/story/?$ https://matrohmatmath.com/?utm_source=instagram&utm_medium=story&utm_campaign=profile [L,R=302]
  RewriteRule ^ig/?$ https://matrohmatmath.com/?utm_source=instagram&utm_medium=bio&utm_campaign=profile [L,R=302]

  # Jangan redirect kalau file/folder ada
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Jangan redirect request ke /api
  RewriteCond %{REQUEST_URI} !^/api/
  # Semua route lain → render.php (inject meta tags per URL, lalu serve index.html)
  RewriteRule . /render.php [L]
</IfModule>

<IfModule mod_headers.c>
  # sw.js/registerSW.js/index.html HARUS selalu di-revalidate — kalau di-cache CDN
  # lama (default Hostinger), deploy baru bisa tertahan sampai cache lama expire.
  # File di /assets/ (nama ber-hash) TIDAK kena rule ini, tetap boleh di-cache lama.
  <FilesMatch "^(sw\.js|registerSW\.js|index\.html)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
